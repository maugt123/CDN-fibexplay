# Configuración del laboratorio (pruebas/docker-compose.yml). No usar en producción.
CDN_ESCUCHAR=:80
CDN_HOST_PUBLICO=localhost:8088

NODOS=caracas,valencia,maracay
NODO_CARACAS_URL=http://caracas
NODO_VALENCIA_URL=http://valencia
NODO_MARACAY_URL=http://maracay
NODO_CARACAS_HOST_HEADER=ccs.fibexplay.tv
NODO_RESPALDO=caracas
ZONA_POR_DEFECTO=caracas

SALUD_MODO=tcp
SALUD_INTERVALO=2s
SALUD_TIMEOUT=1s
SALUD_FALLOS_PARA_CAER=3
SALUD_EXITOS_PARA_VOLVER=3
RAMPA_DURACION=20s

RUTAS_FUENTE=mysql
RUTAS_MYSQL_HOST=mysql
RUTAS_MYSQL_PUERTO=3306
RUTAS_MYSQL_USUARIO=cdn_lectura
RUTAS_MYSQL_CLAVE=solo-laboratorio
RUTAS_MYSQL_BD=xui
RUTAS_MYSQL_TABLA=lines
RUTAS_REFRESCO=5s
RUTAS_RECARGA_COMPLETA=1h

CDN_TOKEN_ADMIN=token-laboratorio
LOG_NIVEL=info
