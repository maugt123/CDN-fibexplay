# ============================================================================
#  Fibex CDN — configuración
#  Formato: CLAVE=valor. Las líneas que empiezan con # se ignoran.
#  Cualquier clave también puede venir como variable de entorno (gana el entorno).
# ============================================================================

# --- Dónde escucha el CDN ---------------------------------------------------
# Puerto local. En Debian el servicio puede usar :80 sin ser root.
CDN_ESCUCHAR=:80

# Nombre o IP pública con la que los clientes llegan a ESTE servidor
# (ej. cdn.fibexplay.tv o 203.0.113.10:8080). Si se llena, el CDN corrige las
# respuestas de player_api.php y get.php para que la app siga pidiendo los
# canales al CDN y no directo a Caracas. Vacío = no tocar las respuestas.
CDN_HOST_PUBLICO=

# --- Nodos XUI --------------------------------------------------------------
# Lista de nodos. Cada uno necesita NODO_<NOMBRE>_URL (dirección pública,
# a la que se redirige a los abonados). Usar IPs, no ccs.fibexplay.tv.
# Las IPs reales se entregan aparte, no van en el repositorio.
NODOS=caracas,valencia,maracay

NODO_CARACAS_URL=http://IP-PUBLICA-CARACAS
NODO_VALENCIA_URL=http://IP-PUBLICA-VALENCIA
NODO_MARACAY_URL=http://IP-PUBLICA-MARACAY

# Host que se envía a un nodo cuando el CDN le pasa una petición (player_api,
# EPG...). XUI de Caracas responde con su dominio.
NODO_CARACAS_HOST_HEADER=ccs.fibexplay.tv

# Otras IPs o nombres con los que se conoce a un nodo (separados por coma).
# Sirve para entender las rutas que escribe el orquestador (usa la IP privada).
NODO_CARACAS_ALIAS=ccs.fibexplay.tv
NODO_VALENCIA_ALIAS=IP-PRIVADA-VALENCIA

# Nodo de respaldo: recibe a los abonados cuando su nodo está caído.
NODO_RESPALDO=caracas

# Zona para abonados que no aparecen en la fuente de rutas.
ZONA_POR_DEFECTO=caracas

# --- Vigilancia de los nodos ------------------------------------------------
# tcp  = basta con que el puerto acepte conexiones (recomendado para XUI).
# http = pide SALUD_RUTA y exige una respuesta menor a 500.
SALUD_MODO=tcp
SALUD_RUTA=/
SALUD_INTERVALO=5s
SALUD_TIMEOUT=3s
# Fallos seguidos para declarar un nodo caído (3 x 5s = 15s).
SALUD_FALLOS_PARA_CAER=3
# Éxitos seguidos para empezar a devolverle abonados (6 x 5s = 30s).
SALUD_EXITOS_PARA_VOLVER=6
# Retorno escalonado: 25% -> 50% -> 75% -> 100% repartido en este tiempo.
# 0 = devolver a todos de una vez.
RAMPA_DURACION=9m

# --- De dónde sale la ciudad de cada abonado --------------------------------
# mysql   = lee la tabla `lines` del XUI de Caracas (solo lectura). Independiente.
# redis   = lee proxy:route:{usuario} del Redis del orquestador.
# archivo = lee un CSV "usuario,zona".
# ninguna = todos van a ZONA_POR_DEFECTO (solo para pruebas).
RUTAS_FUENTE=ninguna

# mysql: basta un usuario con permiso SELECT sobre la tabla lines.
RUTAS_MYSQL_HOST=IP-PUBLICA-CARACAS
RUTAS_MYSQL_PUERTO=3306
RUTAS_MYSQL_USUARIO=
RUTAS_MYSQL_CLAVE=
RUTAS_MYSQL_BD=xui
RUTAS_MYSQL_TABLA=lines

# redis: redis://:clave@host:6379/0
RUTAS_REDIS_URL=
RUTAS_REDIS_PREFIJO=proxy:route:
RUTAS_REDIS_CACHE=30s

# archivo: una línea por abonado, "usuario,zona" (zona = nombre del nodo o su IP).
RUTAS_ARCHIVO=/etc/fibex-cdn/rutas.csv

# Cada cuánto se buscan abonados nuevos y cada cuánto se relee todo.
RUTAS_REFRESCO=60s
RUTAS_RECARGA_COMPLETA=1h

# --- Administración ---------------------------------------------------------
# Si se llena, habilita GET /cdn/ruta/<usuario> con la cabecera X-Token-Admin.
CDN_TOKEN_ADMIN=

# debug | info | warn | error
LOG_NIVEL=info
